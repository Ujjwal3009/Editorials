# Database Configuration
DB_NAME=upsc_db
DB_USER=upsc_admin
DB_PASSWORD=upsc_secret
DB_HOST=localhost
DB_PORT=5432

# 🛡️ Gemini AI Feature Flag
# Leave false to run entirely offline with heuristic syllabus mapping & local dictionary
# Set to true and provide API key to enable live Gemini 2.5 Pro / Flash synthesis
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
